# Astro A50 X base station (Logitech 046d:0b0b): give the logged-in user access to its hidraw node
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="0b0b", TAG+="uaccess"

# Split its audio into separate Game and Chat outputs with PipeWire's gaming headset profile set,
# as PipeWire's own 90-pipewire-alsa.rules already does for the A50 Gen 5 (046d:0b1c)
SUBSYSTEM=="sound", ACTION=="change", KERNEL=="card*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="0b0b", ENV{ACP_PROFILE_SET}="usb-gaming-headset.conf"
